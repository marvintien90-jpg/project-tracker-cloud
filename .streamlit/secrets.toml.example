# 範本：把這個檔案內容複製到 Streamlit Cloud → App settings → Secrets
# 本地測試時，把這個檔案另存為 .streamlit/secrets.toml（已被 .gitignore 排除）
# 千萬不要把實際的 secrets.toml 提交到 GitHub！

openai_api_key = "sk-proj-你的新 OpenAI Key"

[google_sheets]
spreadsheet_id = "你的 Google Sheet ID（網址中間那段）"
drive_folder_id = "1eaYvcY2ghdtRTzCGfJlgGQY4x0MtxFf8"

# 把下載的 Service Account JSON 整個貼進來（每個欄位轉成 toml 格式）
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project"
private_key_id = "xxx"
private_key = """-----BEGIN PRIVATE KEY-----
換行的私鑰內容...
-----END PRIVATE KEY-----
"""
client_email = "project-tracker-bot@your-gcp-project.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/project-tracker-bot%40your-gcp-project.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
